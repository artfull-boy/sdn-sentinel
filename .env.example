GF_SECURITY_ADMIN_PASSWORD=change-me

# Mitigation engine (read by ./start-mitigation.sh, see docs/MITIGATION_README.md section 5)
# tau from the detector's notebook 02 (99.5th percentile of normal scores):
#SENTINEL_TAU=0.6
# Grafana service-account token, for annotations on the dashboard:
#GRAFANA_TOKEN=glsa_...

# When the engine removes a mitigation: from measurements, never from a timer.
# Flood and slow flood (BLOCK <-> SAMPLE cycle):
FLOOD_BLOCK_CHECK_S=6       # read the port rule's packet counter every 6 s (ONOS refreshes it every ~5 s)
FLOOD_BLOCK_PKTS=200        # more packets than this per check -> keep blocking, else -> SAMPLE
FLOOD_SAMPLE_PPS=8          # SAMPLE: meter that lets 8 packets/s reach the controller
FLOOD_SAMPLE_CHECK_S=3      # SAMPLE: count new hosts (MACs) on that port every 3 s
FLOOD_NEW_HOSTS=5           # more new hosts than this per check = still attacking (max visible: 8 pkt/s x 3 s = 24)
FLOOD_CONFIRM_CHECKS=2      # that many attacking checks in a row -> back to the drop rule
FLOOD_RELEASE_CHECKS=3      # that many calm checks in a row -> release (no rules); 3 x 3 s = 9 s > the 6 s pauses of a pulsed flood
# Spoofing (counter of the rule dropping the victim's MAC on the attacker's port):
SPOOF_CHECK_S=6             # read it every 6 s
SPOOF_MAX_PKTS=0            # more spoofed frames than this per check -> keep the block
SPOOF_CONFIRM_CHECKS=2      # at most that, that many checks in a row -> release
